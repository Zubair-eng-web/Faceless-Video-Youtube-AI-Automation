GEMINI_API_KEY=your_gemini_key_here
PIXABAY_API_KEY=your_pixabay_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# AI provider aur limits (Step 33)
AI_PROVIDER=gemini
GEMINI_MAX_ATTEMPTS=4
GEMINI_RETRY_DELAY=5
# Free tier: 4 rakhein (lagbhag 15 requests/minute). Paid key: 0
GEMINI_MIN_INTERVAL_SECONDS=0

# Long-form video format
LONG_VIDEO_WIDTH=1920
LONG_VIDEO_HEIGHT=1080

# Long-form video settings (Step 23)
LONG_WORDS_PER_MINUTE=150
LONG_SCENE_SECONDS=7
LONG_MAX_SCENE_WORDS=32
LONG_MIN_MINUTES=3
LONG_MAX_MINUTES=20
LONG_MAX_SCENES=150
LONG_GEMINI_MODEL=
LONG_FACTCHECK_GROUNDED=1
LONG_FACTCHECK_AUTOFIX=1LONG_RESEARCH_GROUNDED=1

# Long-form narration (Step 28)
LONG_VOICE=
LONG_VOICE_RATE=+0%
LONG_SCENE_PAUSE=0.15
LONG_CHAPTER_PAUSE=0.7
LONG_TARGET_LUFS=-16
